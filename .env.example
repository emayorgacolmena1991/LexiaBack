LEXIA_DB_HOST=51.79.11.21
LEXIA_DB_PORT=5432
LEXIA_DB_NAME=lexia
LEXIA_DB_USER=lexia_app
LEXIA_DB_PASSWORD=
LEXIA_FLYWAY_USER=lexia_migrator
LEXIA_FLYWAY_PASSWORD=

# Brevo (correos transaccionales)
# En staging (SPRING_PROFILES_ACTIVE=staging) Brevo queda habilitado por defecto.
LEXIA_BREVO_ENABLED=false
LEXIA_BREVO_API_KEY=
LEXIA_BREVO_SENDER_EMAIL=noreply@lexia.app
LEXIA_BREVO_SENDER_NAME=LEXIA
LEXIA_FRONTEND_URL=http://localhost:4200
LEXIA_SERVER_PORT=8081

# Solo desarrollo/CI: expone POST /api/v1/admin/e2e/invite con token en respuesta
# Habilita POST /api/v1/auth/e2e/session y POST /api/v1/admin/e2e/invite (omitir MFA en tests)
LEXIA_E2E_ENABLED=false

# Gemini (análisis de texto OCR / extracción legada)
GEMINI_API_KEY=

# LLM post-OCR: gemini | claude
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001

# Azure Document Intelligence (OCR texto plano — módulo 1)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://mi-ocr-document-service.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# F0 rate-limit: 1 concurrent + exponential backoff en 429
# AZURE_OCR_MAX_CONCURRENT=1
# AZURE_OCR_MAX_RETRIES=6
# AZURE_OCR_BACKOFF_BASE_MS=1000
# AZURE_OCR_BACKOFF_MAX_MS=60000
